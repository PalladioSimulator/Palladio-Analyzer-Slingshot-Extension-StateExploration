	<!-- Dagger straight from Maven Central: the p2 update sites still ship 2.31,
	     which does not recognise jakarta.inject annotations. The symbolic name is kept
	     as com.google.dagger so the existing Require-Bundle entries keep resolving. -->
	<location includeDependencyDepth="none" includeSource="false" missingManifest="generate" type="Maven">
		<dependencies>
			<dependency>
				<groupId>com.google.dagger</groupId>
				<artifactId>dagger</artifactId>
				<version>2.60.1</version>
				<type>jar</type>
			</dependency>
		</dependencies>
		<instructions><![CDATA[
Bundle-Name:           Dagger
version:               ${version_cleanup;${mvnVersion}}
Bundle-SymbolicName:   com.google.dagger
Bundle-Version:        ${version}
Import-Package:        *;resolution:=optional
Export-Package:        *;version="${version}";-noimport:=true
]]></instructions>
	</location>
</locations>
</target>